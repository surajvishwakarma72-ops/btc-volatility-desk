# App runtime environment (secrets). On the VM: `cp .env.prod.example .env.prod`,
# fill in real values, `chmod 600 .env.prod`. NEVER commit the filled-in .env.prod.
#
# NOTE: DOMAIN is NOT here — it lives in the ROOT ./.env, which docker compose reads
# for Caddy's hostname and for CORS_ORIGINS:
#     echo "DOMAIN=<name>.duckdns.org" > .env

# --- Database (keep Neon; SSL auto-detected from the URL) ---
DATABASE_URL=
DATABASE_CA=

# --- Security ---
JWT_SECRET=
ENCRYPTION_MASTER_KEY=

# --- Exchange / data sources ---
DELTA_EXCHANGE_BASE_URL=https://api.india.delta.exchange
DERIBIT_BASE_URL=
BINANCE_FUTURES_BASE_URL=

# --- Alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
NTFY_DEFAULT_TOPIC=
NTFY_SERVER_URL=
FCM_SERVER_KEY=
