# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated allowlist of browser origins permitted to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Managed PostgreSQL Connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/volatility_desk

# Optional: PEM CA bundle if your managed Postgres uses a private CA (leave empty for Neon/public CAs)
DATABASE_CA=

# Authentication & Encryption
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_32_chars_min
ENCRYPTION_MASTER_KEY=replace_with_a_64_character_hex_key_for_aes_256_gcm

# External API Integration (Optional default overrides)
DELTA_EXCHANGE_BASE_URL=https://api.india.delta.exchange
DERIBIT_BASE_URL=https://www.deribit.com/api/v2/public
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# Notification Gateways
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
NTFY_DEFAULT_TOPIC=
NTFY_SERVER_URL=https://ntfy.sh
# Firebase Cloud Messaging server key for mobile push delivery (optional)
FCM_SERVER_KEY=
